# Data files - keep directory structure with .gitkeep
data/*
!data/.gitkeep

# Model pickle files
models/*.pkl
codes/model/**/*.pkl
documentation/*.tex

# Plots
plots/*.png
plots/*.pdf

# Inference results (large MCMC chains)
Inference/results/*.npy

# MCMC sample chains anywhere in the repo (large binaries, regenerable)
samples_*.npy

# Regenerable caches
Inference_cosmo/cache/*.npz

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoints
.ipynb_checkpoints/

# Backup/copy notebooks
*copy*
*copy_pre*

# OS files
.DS_Store
